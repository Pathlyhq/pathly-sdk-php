{
  "name": "pathlyhq/sdk",
  "description": "Official PHP client for the Pathly monitoring public /v1 API",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "pathly",
    "pathly monitoring",
    "monitoring",
    "uptime",
    "sla",
    "webhooks",
    "synthetic"
  ],
  "homepage": "https://pathlyhq.com",
  "support": {
    "docs": "https://pathlyhq.com/en/developers",
    "source": "https://github.com/pathlyhq/pathly-sdk-php"
  },
  "authors": [
    {
      "name": "Simon Raynaud",
      "homepage": "https://pathlyhq.com",
      "role": "Author / keyral"
    },
    {
      "name": "Pathly",
      "homepage": "https://pathlyhq.com",
      "role": "Company"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Pathly\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Pathly\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --coverage-text"
  },
  "config": {
    "sort-packages": true
  }
}
